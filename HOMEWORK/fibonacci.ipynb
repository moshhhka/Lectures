   "source": [
    "N = int(input(\"Enter a number to compute Fibonacci: \"))\n",
    "print('You entered:', N)\n",
    "\n",
    "def fib_regular(N:int) -> int:\n",
    "    if N <= 1:\n",
    "        return N\n",
    "    return fib_regular(N-1) + fib_regular(N-2)\n",
    "\n",
    "print('Fibonacci (regular):', fib_regular(N))"
   ]
  }
 ],
